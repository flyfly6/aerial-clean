              "gap": 28,
              "children": [
                {
                  "type": "frame",
                  "id": "dYKw5",
                  "name": "Card 1 - Wallpaper Engine",
                  "width": 882,
                  "height": 406,
                  "fill": "#1E293B",
                  "cornerRadius": 24,
                  "stroke": "#334155",
                  "strokeWidth": 1,
                  "layout": "vertical",
                  "gap": 16,
                  "padding": [
                    28,
                    32
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "w2XjXD",
                      "name": "Card 1 Title",
                      "fill": "#38BDF8",
                      "content": "1. 静态壁纸与三档分辨率实现方案",
                      "fontFamily": "Outfit",
                      "fontSize": 20,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "b3ykp",
                      "name": "Point Text",
                      "fill": "#CBD5E1",
                      "content": "● 必应每日精选：后台异步任务拉取官方 Bing Image API，优先从本地文件缓存读取，断网秒开 0 阻塞。",
                      "lineHeight": 1.5,
                      "fontFamily": "Inter",
                      "fontSize": 14
                    },
                    {
                      "type": "text",
                      "id": "DG0ee",
                      "name": "Point Text",
                      "fill": "#CBD5E1",
                      "content": "● 14 张内置壁纸：内置高清航拍与自然风光，离线零网络依赖，支持定时每小时/每天自动轮换。",
                      "lineHeight": 1.5,
                      "fontFamily": "Inter",
                      "fontSize": 14
                    },
                    {
                      "type": "text",
                      "id": "jOGEH",
                      "name": "Point Text",
                      "fill": "#CBD5E1",
                      "content": "● 720p 分辨率 (省内存)：针对 512MB~1GB 内存老设备，采用 inSampleSize 降采样到 1280×720，内存仅 2.8MB，避免被后台 LMK 强杀。",
                      "lineHeight": 1.5,
                      "fontFamily": "Inter",
                      "fontSize": 14
                    },
                    {
                      "type": "text",
                      "id": "NV5hg",
                      "name": "Point Text",
                      "fill": "#CBD5E1",
                      "content": "● 1080p 分辨率 (均衡)：1920×1080 全高清显示，内存 ~8.2MB，色彩平滑细腻，兼顾画质与启动速度。",
                      "lineHeight": 1.5,
                      "fontFamily": "Inter",
                      "fontSize": 14
                    },
                    {
                      "type": "text",
                      "id": "zxVaG",
                      "name": "Point Text",
                      "fill": "#CBD5E1",
                      "content": "● 4K 分辨率 (超清)：3840×2160，内存 ~33MB，适合 2GB+ 现代高端大屏电视。",
                      "lineHeight": 1.5,
                      "fontFamily": "Inter",
                      "fontSize": 14
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "SVJXI",
                  "name": "Card 2 - Remote Focus Engine",
                  "width": 882,
                  "height": 406,
                  "fill": "#1E293B",
